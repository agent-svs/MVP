  {
   "id": "e0e9bac31",
   "type": "text",
   "x": 10,
   "y": 6026.0,
   "width": 1974,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "ec8b6be1f",
   "roundness": null,
   "seed": 183137250,
   "version": 1,
   "versionNonce": 697289833,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "VERDICT —  A (Hybrid NLU) wins only on narrow, scripted, very high-volume flows (OTP, payment reminders, surveys): cheapest and deterministic, but it cannot be the brain of a smart, generic agent.  B (Pure\nLLM) wins on time-to-demo and naturalness, and loses on everything that costs money in production: truthfulness, hallucination, latency, compliance.  C is the only design that is smart AND truthful AND fast\nAND multi-tenant; its price is engineering effort.  Migration: keep your current NLU + slot extractor as a cheap fast-path router and entity validator INSIDE C — it becomes a component, not the brain.",
   "originalText": "VERDICT —  A (Hybrid NLU) wins only on narrow, scripted, very high-volume flows (OTP, payment reminders, surveys): cheapest and deterministic, but it cannot be the brain of a smart, generic agent.  B (Pure\nLLM) wins on time-to-demo and naturalness, and loses on everything that costs money in production: truthfulness, hallucination, latency, compliance.  C is the only design that is smart AND truthful AND fast\nAND multi-tenant; its price is engineering effort.  Migration: keep your current NLU + slot extractor as a cheap fast-path router and entity validator INSIDE C — it becomes a component, not the brain.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
  }
