   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "• small fine-tuned LLM (≈8B), self-hosted in Mumbai, first token\n≈100–150 ms\n• input = compact STATE + last 2 turns (not whole transcript)\n• starts drafting on ASR partials (speculative), commits at turn end\n• owns conversational glue: empathy, acks, honest fillers, mirroring\nHinglish\n• never decides facts or actions itself",
   "originalText": "• small fine-tuned LLM (≈8B), self-hosted in Mumbai, first token\n≈100–150 ms\n• input = compact STATE + last 2 turns (not whole transcript)\n• starts drafting on ASR partials (speculative), commits at turn end\n• owns conversational glue: empathy, acks, honest fillers, mirroring\nHinglish\n• never decides facts or actions itself",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
