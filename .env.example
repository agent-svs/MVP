# ============================================================
# AI Voice Receptionist — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# === Device Configuration ===
# Options: cpu | mps | cuda | auto
# "auto" will detect CUDA first, then MPS (Apple Silicon), then CPU
DEVICE=auto
# Options: int8 | float16 | float32
# int8 is fastest on CPU, float16 is best for GPU
COMPUTE_TYPE=int8

# === STT (Faster Whisper) ===              
# Model sizes: tiny | base | small | medium | large-v3
# Recommended: "base" for Mac CPU, "medium" for GPU
STT_MODEL_SIZE=base
STT_LANGUAGE=en
STT_BEAM_SIZE=5

# === TTS (Coqui XTTS v2) ===
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
# Built-in speaker name (58 available: Daisy Studious, Andrew Chipper, etc.)
TTS_SPEAKER=Daisy Studious
# Path to a 6-15 second reference WAV for voice cloning
# If this file exists, voice cloning is used instead of the built-in speaker
TTS_SPEAKER_WAV=assets/reference_voice.wav
TTS_LANGUAGE=en

# === LLM (Google Gemini) ===
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here
# Models: gemini-2.5-flash | gemini-2.5-pro | etc.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=256
GEMINI_TEMPERATURE=0.7

# === Audio ===
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_DURATION_MS=30

# === VAD (Voice Activity Detection) ===
# Lower = more sensitive (picks up more speech), Higher = less sensitive
VAD_THRESHOLD=0.5
# Minimum speech duration to consider as valid utterance (ms)
VAD_MIN_SPEECH_MS=250
# Silence duration to mark end of utterance (ms)
VAD_MIN_SILENCE_MS=700

# === NLU (Natural Language Understanding) ===
# Set to "true" to use the Joint NLU model (DeBERTa intent + slot in one pass)
# Set to "false" to use the separate zero-shot intent + NER pipeline
JOINT_NLU_ENABLED=false
# Joint NLU model path (only used when JOINT_NLU_ENABLED=true)
JOINT_NLU_MODEL_PATH=models/joint_nlu/
# Set to "true" to use fine-tuned intent classifier instead of zero-shot
# (only used when JOINT_NLU_ENABLED=false)
INTENT_FINE_TUNED=false
# Fine-tuned model path (local dir or HuggingFace Hub repo)
# Examples:  models/intent_classifier  |  your-username/clinic-intent-classifier
INTENT_MODEL=models/intent_classifier
# Confidence thresholds for routing decisions (ML-calibrated)
NLU_CONFIDENCE_HIGH=0.80
NLU_CONFIDENCE_LOW=0.50

# === System ===
LOG_LEVEL=INFO
