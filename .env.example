# ============================================================
# AI Voice Receptionist — Environment Configuration
#   cp .env.example .env   then fill in GEMINI_API_KEY
# ============================================================

# === Device ===
# cpu | mps | cuda | auto   (auto: CUDA > MPS > CPU)
DEVICE=auto
# int8 | float16 | float32  (CTranslate2/STT always uses int8 on CPU)
COMPUTE_TYPE=int8

# === STT (Faster Whisper) ===
# tiny | base | small | medium | large-v3 | distil-*
# "base" is the right default on Mac CPU; "medium" is ~3x slower.
STT_MODEL_SIZE=base
STT_LANGUAGE=en
STT_BEAM_SIZE=5
# Utterances quieter/shorter than this are discarded before transcription.
# Keep min duration low — replies like "yes" or "3 pm" are ~0.3s.
STT_MIN_AMPLITUDE=0.015
STT_MIN_DURATION_S=0.25
# Peak amplitude below which canned Whisper phrases ("thank you") are treated
# as silence hallucinations.
STT_HALLUCINATION_AMPLITUDE=0.06

# === TTS (Coqui XTTS v2) ===
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
TTS_SPEAKER=Daisy Studious
# Optional 6-15s reference WAV for voice cloning; used only if the file exists.
TTS_SPEAKER_WAV=assets/reference_voice.wav
TTS_LANGUAGE=en
# Only PII-free phrases are ever cached (see core/tts.py).
TTS_CACHE_ENABLED=true
TTS_CACHE_MAX_FILES=256

# === LLM (Google Gemini) ===
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=256
GEMINI_TEMPERATURE=0.7
# Hard per-request timeout; a hung call must never stall the voice loop.
GEMINI_TIMEOUT_S=12
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_S=1.0
# gemini-2.5-* "thinking" adds latency and eats max_output_tokens. 0 = off.
GEMINI_THINKING_BUDGET=0

# === Audio I/O ===
# Silero VAD supports 8000 or 16000 only.
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_DURATION_MS=30
# Bounded mic queue — prevents stale audio piling up during a slow turn.
AUDIO_MAX_QUEUE_CHUNKS=100
# Silence after the agent stops speaking, so the speaker tail and room
# reverb decay before the mic is re-armed. Too low and the agent
# transcribes the end of its own sentence as the caller's reply.
AUDIO_ECHO_COOLDOWN_MS=350

# === VAD ===
# Higher threshold = less sensitive to noise.
VAD_THRESHOLD=0.5
# Minimum speech to count as an utterance. Do NOT raise above ~300 —
# "yes" / "no" / "3 pm" are shorter than that and would be discarded.
VAD_MIN_SPEECH_MS=200
# Silence that marks the end of a turn.
VAD_MIN_SILENCE_MS=600

# Barge-in must clear a higher bar than normal speech detection, because
# the mic hears the agent's own speakers. Raise the amplitude floor if the
# agent interrupts itself; lower it if real interruptions are missed.
VAD_BARGE_IN_THRESHOLD=0.85
VAD_BARGE_IN_MIN_AMPLITUDE=0.12
VAD_BARGE_IN_CONSECUTIVE=4
VAD_BARGE_IN_GRACE_MS=400

# === Audio preprocessing ===
# High-pass runs per chunk (stateful). Denoise + AGC run once per complete
# utterance, so they cannot distort the loudness VAD depends on.
PREPROCESS_HIGHPASS_HZ=80
PREPROCESS_HIGHPASS_ORDER=4
PREPROCESS_DENOISE=true
PREPROCESS_DENOISE_STRENGTH=0.75
PREPROCESS_AGC=true
PREPROCESS_AGC_TARGET_RMS=0.08
PREPROCESS_AGC_MAX_GAIN=8.0

# === NLU ===
# Joint DeBERTa model (intent + slots in one pass). This is the production path.
JOINT_NLU_ENABLED=true
JOINT_NLU_MODEL_PATH=models/joint_nlu/
# Fallback if the local path is missing.
JOINT_NLU_HUB_ID=agents-svs/voice-receptionist-joint-nlu
# Legacy separate-model path (only used when JOINT_NLU_ENABLED=false)
INTENT_FINE_TUNED=false
INTENT_MODEL=MoritzLaurer/deberta-v3-xsmall-zeroshot-v1.1-all-33
NER_MODEL=dslim/bert-base-NER
# Routing thresholds
NLU_CONFIDENCE_HIGH=0.80
NLU_CONFIDENCE_LOW=0.50
NLU_SLOT_CONFIDENCE=0.75

# === Business rules (single source of truth) ===
BUSINESS_NAME=Apex Medical Clinic
BUSINESS_ADDRESS=123 Healthway Drive, Suite 100
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18
BUSINESS_MAX_DAYS_AHEAD=180

# === Logging / privacy ===
LOG_LEVEL=INFO
# Turn logging contains conversation content. Redaction is ON by default;
# set NLU_LOG_ENABLED=false to disable logging entirely.
NLU_LOG_ENABLED=true
NLU_LOG_REDACT_PII=true
NLU_LOG_MAX_BYTES=5242880
NLU_LOG_BACKUPS=3
