  {
   "id": "e84b5a818",
   "type": "text",
   "x": 920,
   "y": 696.0,
   "width": 540,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
